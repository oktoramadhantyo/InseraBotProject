# Salin file ini menjadi .env lalu isi nilainya.
# Catatan: file .env TIDAK boleh di-commit ke git.

# ===== Browser / Selenium =====
# Port Chrome remote debugging (jalankan Chrome dengan flag
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\chrome-debug"
# agar bot bisa attach ke sesi Chrome yang sudah login Insera).
DEBUG_PORT=9222

# URL halaman ALL TICKET LIST Insera
# INSERA_URL=oss-incident.telkom.co.id/jw/web/userview/ticketIncidentService/ticketIncidentService/_/allTicketList

